# ====================================================================
# Census Assistant Environment Variables Configuration
# ====================================================================

PORT=8080

# --------------------------------------------------------------------
# AI Assistant
# --------------------------------------------------------------------
# GEMINI_API_KEY is what makes the assistant a general-purpose AI. Without
# it every question falls back to the offline synthesizer, which can only
# answer from the ingested Excel records and PDF manuals — the assistant
# will appear to be "restricted to the PDFs". Get a free key from Google AI
# Studio and set it here (or in the PythonAnywhere web app's environment
# variables panel, then Reload the web app).
# Check the current state at Admin -> AI Provider Status.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Free PythonAnywhere accounts reach the internet only through an HTTP proxy,
# and only for allowlisted hosts. If the key is set but Admin -> AI Provider
# Status still reports the API unreachable, set this:
#   OUTBOUND_HTTP_PROXY=http://proxy.server:3128
# Paid PythonAnywhere accounts have unrestricted access and need nothing here.
OUTBOUND_HTTP_PROXY=

# Override the Gemini base URL. Only needed for testing against a stub or a
# mirror; leave blank to use Google's public endpoint.
GEMINI_API_BASE=

# Security
JWT_SECRET=census_assistant_super_secret_jwt_key_2026

# Dev-only OTP convenience (leave unset/false in any real deployment!).
# When true, /api/auth/request-otp echoes the generated code back in its
# response and /api/auth/verify-otp accepts a universal "123456" bypass code.
DEV_OTP_BYPASS=false

# WhatsApp Cloud API Configuration
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=census_assistant_webhook_verify_2024

# Telegram Bot Fallback Channel
TELEGRAM_BOT_TOKEN=

# Technical Assistant Contact Details
TECH_ASSISTANT_NAME=Shahin Sha A.
TECH_ASSISTANT_PHONE=+91 84534 41975
SUPERVISOR_NAME=S. A. Ahmed
CIRCLE_NAME=Lakhipur Circle
